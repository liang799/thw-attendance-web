DB_NAME=thw_parade
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
# DISABLED for local MySQL, REQUIRED for TLS, VERIFY_IDENTITY with a trusted CA.
DB_SSL_MODE=DISABLED
# Optional path to the CA certificate, relative to the backend directory.
# DB_SSL_CA_PATH=./ca.pem
# On hosted deployments, set DB_SSL_CA to the full PEM certificate instead.
# DB_SSL_CA takes precedence over DB_SSL_CA_PATH.
JWT_SECRET="replace-with-a-random-secret"
USER_DEFAULT_PASSWORD="replace-with-a-seed-password"
